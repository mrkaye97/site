---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const flat = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);

const items: (Heading & { children: Heading[] })[] = [];
for (const h of flat) {
  const parent = items.at(-1);
  if (h.depth === 3 && parent) parent.children.push(h);
  else items.push({ ...h, children: [] });
}
---

{
  flat.length > 2 && (
    <nav class="toc" aria-label="On this page">
      <ol>
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
            {h.children.length > 0 && (
              <ol>
                {h.children.map((c) => (
                  <li>
                    <a href={`#${c.slug}`}>{c.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  // Highlight every section that is at least partly on screen, not just the
  // nearest heading, so a short section and a long one read the same way.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  const headings = links
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((el): el is HTMLElement => el !== null);
  const prose = document.querySelector(".prose");

  let queued = false;
  const update = () => {
    queued = false;
    const viewBottom = window.innerHeight;
    const proseBottom = prose?.getBoundingClientRect().bottom ?? Infinity;
    headings.forEach((h, i) => {
      const top = h.getBoundingClientRect().top;
      const bottom =
        headings[i + 1]?.getBoundingClientRect().top ?? proseBottom;
      const visible = top < viewBottom && bottom > 0;
      links[i].classList.toggle("active", visible);
    });
  };
  const schedule = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };

  if (headings.length === links.length && links.length > 0) {
    update();
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule);
  }
</script>

<style>
  .toc {
    position: sticky;
    top: 2rem;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    color: var(--ink);
    font-weight: 600;
  }

  svg {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--rule);
  }

  /* Nested lists share the outer rail, so the active bar always lands on
     the same line no matter how deep the heading is. */
  ol ol {
    border-left: 0;
  }

  a {
    display: block;
    margin-left: -1px;
    padding: 0.35rem 0 0.35rem 0.9rem;
    border-left: 1px solid transparent;
    color: var(--ink-soft);
    text-decoration: none;
    transition:
      color 120ms,
      border-color 120ms;
  }

  ol ol a {
    padding-left: 1.9rem;
  }

  a:hover {
    color: var(--ink);
  }

  a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }
</style>
