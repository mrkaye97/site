---
import "../styles/global.css";

// Preloaded so the serif is in hand before first paint. Without this the
// fallback renders first and the swap reflows the whole page.
import serifRoman from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import serifItalic from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-italic.woff2?url";

interface Props {
  title: string;
  description?: string;
  // Crossposts point at wherever they first appeared.
  canonical?: string;
  ogImage?: string;
}

const { title, description, canonical, ogImage = "site" } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(`/og/${ogImage}.png`, Astro.site);
const shareTitle = title.replace(/\s*—\s*sn-p\.sh$/, "");
// Trailing slashes vary by route, so compare without one.
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const nav = [
  { href: "/writing", label: "Writing" },
  { href: "/travel", label: "Travel" },
  { href: "/favorites", label: "Favorites" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={serifRoman}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={serifItalic}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex, nofollow" />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta
      name="theme-color"
      content="#eceee9"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#14282c"
      media="(prefers-color-scheme: dark)"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sn-p.sh" />
    <meta property="og:title" content={shareTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl.href} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="sn-p.sh"
      href="/rss.xml"
    />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="wrap">
      <header>
        <a class="mark" href="/">sn-p.sh</a>
        <nav>
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={here === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main id="content"><slot /></main>
      <footer>
        <nav aria-label="Elsewhere">
          <a href="mailto:me@sn-p.sh">Email</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </footer>
    </div>
  </body>
</html>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 4.5rem;
    flex-wrap: wrap;
  }

  .mark {
    font-family: var(--mono);
    font-size: 0.9375rem;
    color: var(--ink);
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }

  nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  header nav a:hover,
  header nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 0;
    padding: 0.6rem 1rem;
    background: var(--paper);
    color: var(--ink);
  }

  .skip:focus {
    left: 0;
    z-index: 10;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  footer p {
    margin: 0;
  }

  footer nav {
    gap: 1.25rem;
    font-size: inherit;
  }

  footer nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
