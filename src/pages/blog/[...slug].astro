---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import type { CollectionEntry } from "astro:content";

export const getStaticPaths = async () => {
  const posts = await getCollection(
    "blog",
    ({ data }) => import.meta.env.DEV || !data.hidden,
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const stamp = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
---

<Base
  title={`${post.data.title} — sn-p.sh`}
  description={post.data.description}
  canonical={post.data.original}
  ogImage={post.id}
>
  <div class="post">
    <article>
      <h1>{post.data.title}</h1>
      <p class="standfirst">{post.data.description}</p>
      <p class="stamp">
        <time datetime={post.data.date.toISOString()}>{stamp}</time>
        {
          post.data.original && (
            <>
              {" · "}
              <a href={post.data.original} rel="noopener">
                first published on {new URL(post.data.original).hostname}
              </a>
            </>
          )
        }
      </p>
      <div class="prose"><Content /></div>
    </article>
    {
      post.data.toc && (
        <aside class="toc-rail">
          <TableOfContents headings={headings} />
        </aside>
      )
    }
  </div>
  <p class="back"><a href="/writing">All writing</a></p>
</Base>

<style>
  /* The one place that keeps a reading measure: running prose at the full
     container width would be well past a comfortable line length. */
  article {
    max-width: var(--measure);
  }

  .toc-rail {
    display: none;
  }

  @media (min-width: 68rem) {
    .post {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) minmax(11rem, 15rem);
      justify-content: space-between;
      gap: 4rem;
    }

    .toc-rail {
      display: block;
    }
  }

  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 2rem;
  }

  h1 {
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    margin: 0 0 0.5rem;
    text-wrap: balance;
  }

  .standfirst {
    font-size: 1.25rem;
    font-style: italic;
    color: var(--ink-soft);
    margin: 0 0 1rem;
    text-wrap: pretty;
  }

  .stamp {
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin: 0 0 3rem;
  }

  .prose {
    max-width: var(--measure);
  }
  .prose :global(h2) {
    font-size: 1.5rem;
    margin: 2.75rem 0 0.75rem;
  }
  .prose :global(h3) {
    font-size: 1.1875rem;
    margin: 2rem 0 0.5rem;
  }
  .prose :global(p) {
    margin: 0 0 1.25rem;
  }
  .prose :global(img),
  .prose :global(video) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2rem 0;
    border-radius: 2px;
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 2.5rem 0;
  }

  .back {
    max-width: var(--measure);
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
  }
</style>
