---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import photos from "../data/travel.json";

const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/travel/*.{jpg,jpeg}",
  { eager: true },
);

const gallery = photos.map((photo) => {
  const file = files[`../assets/travel/${photo.filename}`];
  if (!file) throw new Error(`No such travel photo: ${photo.filename}`);
  return { ...photo, image: file.default };
});
---

<Base title="Travel — sn-p.sh" description="Photographs, with where and when.">
  <div class="gallery">
    {
      gallery.map((photo) => (
        <figure tabindex="0">
          <div
            class="frame"
            style={`aspect-ratio: ${photo.image.width} / ${photo.image.height}`}
          >
            <Picture
              src={photo.image}
              formats={["webp"]}
              widths={[480, 800, 1200]}
              sizes="(max-width: 40rem) 92vw, (max-width: 64rem) 46vw, 30vw"
              loading="lazy"
              decoding="async"
              alt={photo.location}
            />
          </div>
          <figcaption>
            <strong>{photo.location}</strong>
            <span>{photo.date}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</Base>

<style>
  h1 {
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    margin: 0 0 1.25rem;
  }

  .lead {
    margin: 0 0 3.5rem;
    max-width: 46ch;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  /* Columns rather than a grid: every photo is landscape, so an even
     two-column flow reads better than forcing a uniform row height. */
  .gallery {
    columns: 3;
    column-gap: 1.5rem;
  }

  @media (max-width: 64rem) {
    .gallery {
      columns: 2;
    }
  }

  @media (max-width: 40rem) {
    .gallery {
      columns: 1;
    }
  }

  figure {
    position: relative;
    margin: 0 0 1.5rem;
    break-inside: avoid;
  }

  .frame {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    background: var(--rule);
  }

  .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 20%,
      rgb(255 255 255 / 28%) 50%,
      transparent 80%
    );
    background-size: 220% 100%;
    animation: shimmer 1.4s linear infinite;
  }

  .frame.is-loaded {
    background: none;
  }

  .frame.is-loaded::after {
    display: none;
  }

  @keyframes shimmer {
    from {
      background-position: 180% 0;
    }
    to {
      background-position: -80% 0;
    }
  }

  .frame :global(picture) {
    display: block;
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
    transition:
      transform 0.25s ease,
      opacity 0.4s ease;
  }

  :global(html.js) .frame:not(.is-loaded) :global(img) {
    opacity: 0;
  }

  figure:hover .frame :global(img),
  figure:focus-visible .frame :global(img) {
    transform: scale(0.97);
  }

  /* The caption sits over the photo and is revealed on hover. It stays in the
     DOM either way, so assistive tech and the alt text still carry it. */
  figcaption {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 1rem;
    text-align: center;
    border-radius: 2px;
    background: rgb(12 24 26 / 62%);
    color: #fff;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  figure:hover figcaption,
  figure:focus-visible figcaption {
    opacity: 1;
  }

  figcaption strong {
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  figcaption span {
    font-style: italic;
    font-size: 0.875rem;
    opacity: 0.85;
  }

  /* Without a pointer there is no hover, so drop the overlay entirely and set
     the caption below the photo instead of parking a scrim on top of it. */
  @media (hover: none) {
    figcaption {
      position: static;
      display: block;
      padding: 0.5rem 0 0;
      text-align: left;
      background: none;
      color: var(--ink-soft);
      opacity: 1;
    }
    figcaption strong {
      display: block;
      color: var(--ink);
    }
    figcaption span {
      display: block;
    }
    figure:hover .frame :global(img),
    figure:focus-visible .frame :global(img) {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .frame::after {
      animation: none;
    }
    .frame :global(img) {
      transition: none;
    }
  }

  :global(html:not(.js)) .frame::after {
    display: none;
  }
</style>

<script is:inline>
  document.documentElement.classList.add("js");
</script>

<script>
  for (const frame of document.querySelectorAll<HTMLElement>(
    ".gallery .frame",
  )) {
    const img = frame.querySelector("img");
    if (!img) continue;

    if (img.complete && img.naturalWidth > 0) {
      frame.classList.add("is-loaded");
      continue;
    }

    const reveal = () => frame.classList.add("is-loaded");
    img.addEventListener("load", reveal, { once: true });
    img.addEventListener("error", reveal, { once: true });
  }
</script>
