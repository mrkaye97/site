---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (
  await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.hidden)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<Base
  title="Writing — sn-p.sh"
  description="A few essays on measurement, type systems, and self-hosted software."
>
  <h1>Writing</h1>
  <p class="intro">
    I like writing about all kinds of things. It helps me think and clarify my
    own ideas, and I hope that someone else finds some of it useful or
    interesting. I mostly write about engineering (culture, writing software,
    and so on), but I sometimes also write on other things in my life.
  </p>

  {
    years.map(([year, entries]) => (
      <section class="year">
        <h2>{year}</h2>
        <ul>
          {entries.map((post) => (
            <li class:list={{ "is-hidden": post.data.hidden }}>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
              {post.data.hidden && <span class="hidden-badge">hidden</span>}
              <p>
                {post.data.description}
                {post.data.original && (
                  <span class="elsewhere">
                    first published on {new URL(post.data.original).hostname}
                  </span>
                )}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  h1 {
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    margin: 0 0 1.25rem;
  }

  .intro {
    font-size: 1.125rem;
    line-height: 1.55;
    max-width: 46ch;
    color: var(--ink-soft);
    margin: 0 0 3.5rem;
    text-wrap: pretty;
  }

  /* A column for the year rather than a negative offset, so the marker stays
     inside the container instead of hanging off its edge. */
  .year {
    display: grid;
    grid-template-columns: minmax(0, 8rem) 1fr;
    gap: 0 2rem;
    margin-bottom: 3.25rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
  }

  .year h2 {
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  @media (max-width: 48rem) {
    .year {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  li a {
    font-size: 1.3125rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.25;
    display: inline-block;
    text-wrap: balance;
  }

  li a:hover {
    color: var(--accent);
  }

  li p {
    margin: 0.3rem 0 0;
    font-style: italic;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  /* Dev-only: hidden posts are included locally but excluded from prod builds. */
  .is-hidden a {
    color: var(--ink-soft);
    opacity: 0.55;
  }

  .is-hidden p {
    opacity: 0.55;
  }

  .hidden-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    margin-left: 0.5rem;
    vertical-align: middle;
  }

  /* Marks entries that live on someone else's site. */
  .elsewhere {
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    opacity: 0.8;
  }

  .elsewhere::before {
    content: " · ";
  }
</style>
