---
import Base from "../layouts/Base.astro";
---

<Base
  title="sn-p.sh"
  description="My personal website, where I mostly write about engineering, statistics, and life."
>
  <p class="statement">Hi :)</p>

  <div class="body">
    <p>
      This is my personal site. Its name is a play on a "snapshot," whether of my life, my views at
      the time, places I've been, or similar.
    </p>
  </div>
</Base>

<style>
  .statement {
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.3;
    max-width: 22ch;
    margin: 0 0 3rem;
    text-wrap: balance;
  }

  .body {
    max-width: 56ch;
  }

  .body p {
    margin: 0 0 1rem;
    color: var(--ink-soft);
  }

  .body p:last-child {
    margin-bottom: 0;
  }
</style>
