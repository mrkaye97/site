---
import Base from "../layouts/Base.astro";
import entries from "../data/blogroll.json";

const sorted = [...entries].sort((a, b) =>
  (b.date ?? "").localeCompare(a.date ?? ""),
);
const year = (date: string | null) => (date ? date.slice(0, 4) : "");
---

<Base
  title="Blogroll — sn-p.sh"
  description="Writing by other people, worth the time."
>
  <h1>Blogroll</h1>
  <p class="lead">
    Posts by other people that I find myself recommending or thinking about
    often
  </p>

  <ul>
    {
      sorted.map((entry) => (
        <li>
          <a href={entry.url} rel="noopener">
            {entry.title}
          </a>
          <p>
            {entry.author}
            {entry.date && <span class="year"> · {year(entry.date)}</span>}
          </p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  h1 {
    font-size: clamp(1.875rem, 5vw, 2.5rem);
    margin: 0 0 1.25rem;
  }

  .lead {
    margin: 0 0 3.5rem;
    max-width: 46ch;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
  }

  li a {
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.3;
    text-wrap: pretty;
  }

  li a:hover {
    color: var(--accent);
  }

  li p {
    margin: 0.25rem 0 0;
    font-style: italic;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  .year {
    font-style: normal;
    font-variant-numeric: tabular-nums;
  }
</style>
